import { ScrollView } from "std-widgets.slint";

export struct AppTile {
    name: string,
    category: string,
    description: string,
}

export component Shell inherits Window {
    title: "SoffaShell";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 600px;
    background: #101713;
    default-font-family: "sans-serif";
    default-font-size: 20px;
    in property <[AppTile]> apps;
    in-out property <int> selected: 0;
    in-out property <string> status: "Ready when you are.";
    in-out property <bool> launching: false;
    callback navigate(int);
    callback launch();
    callback toggle-fullscreen();
    callback back();
    forward-focus: keyboard;

    keyboard := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.UpArrow || event.text == Key.LeftArrow) {
                root.navigate(-1);
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.RightArrow) {
                root.navigate(1);
                return accept;
            }
            if (event.text == Key.Return) {
                if (!event.repeat) { root.launch(); }
                return accept;
            }
            if (event.text == Key.F11) {
                if (!event.repeat) { root.toggle-fullscreen(); }
                return accept;
            }
            if (event.text == Key.Escape) {
                if (!event.repeat) { root.back(); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 44px;
            spacing: 24px;
            HorizontalLayout {
                Text { text: "soffa / shell"; color: #e5eddf; font-size: 24px; font-weight: 700; }
                Text { text: "YOUR LIVING ROOM, YOUR WAY"; color: #91a38f; font-size: 14px; horizontal-alignment: right; }
            }
            HorizontalLayout {
                spacing: 48px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 20px;
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Text { text: "MAKE YOURSELF AT HOME"; color: #c4e7a0; font-size: 15px; letter-spacing: 2px; }
                    Text { text: root.apps[root.selected].name; color: #f0f5e9; font-size: 64px; font-weight: 800; }
                    Text { text: root.apps[root.selected].description; color: #a7b6a3; font-size: 24px; wrap: word-wrap; }
                    Rectangle { height: 3px; width: 64px; background: #c4e7a0; }
                    Text { text: "Choose an app. Settle in."; color: #849480; font-size: 18px; }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
                ScrollView {
                    width: 390px;
                    content-y: -max(0px, min(root.selected * 154px, self.content-height - self.visible-height));
                    VerticalLayout {
                        spacing: 14px;
                        padding: 4px;
                        for app[index] in root.apps: Rectangle {
                            height: 140px;
                            border-radius: 18px;
                            background: root.selected == index ? #c4e7a0 : #1d2a21;
                            border-width: 2px;
                            border-color: root.selected == index ? #e5ffca : #314332;
                            animate background { duration: 140ms; }
                            VerticalLayout {
                                padding: 24px;
                                spacing: 8px;
                                Text { text: app.category; color: root.selected == index ? #405638 : #91a38f; font-size: 14px; }
                                Text { text: app.name; color: root.selected == index ? #172311 : #e5eddf; font-size: 30px; font-weight: 700; }
                            }
                            TouchArea {
                                clicked => {
                                    root.selected = index;
                                    keyboard.focus();
                                    root.launch();
                                }
                            }
                        }
                    }
                }
            }
            Text { text: root.status; color: root.launching ? #c4e7a0 : #a7b6a3; font-size: 16px; wrap: word-wrap; }
            Rectangle { height: 1px; background: #314332; }
            Text {
                text: "ARROWS  Select     ENTER  Open     F11  Fullscreen     ESC  Leave fullscreen / Quit";
                color: #91a38f;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
    }
}
